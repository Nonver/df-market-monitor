<template>
	<view class="page">
		<view class="tip">
			<text class="tip-text">仅显示预期收益 ≥ {{ minGain }}% 的机会。低于此线扣完成本无利可图，系统直接过滤。</text>
		</view>

		<view class="list">
			<view class="card" v-for="it in list" :key="it.propid" @click="goDetail(it)">
				<view class="card-head">
					<text class="name">{{ it.name }}</text>
					<text class="score">强度 {{ it.score }}</text>
				</view>
				<view class="card-body">
					<view class="col">
						<text class="label">当前价</text>
						<text class="value">{{ fmtPrice(it.price) }}</text>
					</view>
					<view class="col">
						<text class="label">预期收益</text>
						<text class="value gain">{{ it.expected_gain }}%</text>
					</view>
					<view class="col">
						<text class="label">动作</text>
						<text class="value" :class="it.action.toLowerCase()">{{ actionText(it.action) }}</text>
					</view>
				</view>
				<text class="reason">{{ it.reason }}</text>
			</view>
		</view>

		<view class="empty" v-if="list.length == 0">
			<text>当前没有满足门槛的机会</text>
			<text class="empty-sub">价格数据越多，信号越准</text>
		</view>
	</view>
</template>

<script lang="uts">
	import { getOpportunities, getStats, fmtPrice } from '@/utils/api.uts'

	export default {
		data() {
			return {
				list: [] as any[],
				minGain: 15
			}
		},
		onLoad() {
			this.load()
		},
		onShow() {
			this.load()
		},
		onPullDownRefresh() {
			this.load()
		},
		methods: {
			async load() {
				try {
					const res = await getOpportunities()
					if (res.ok) {
						const all = res.data as any[]
						const buys = [] as any[]
						for (let i = 0; i < all.length; i++) {
							if (all[i].action != 'HOLD') buys.push(all[i])
						}
						this.list = buys
					}
					const s = await getStats()
					if (s.ok) this.minGain = s.min_gain_threshold
				} catch (e) {
					uni.showToast({ title: '加载失败', icon: 'none' })
				}
				uni.stopPullDownRefresh()
			},
			goDetail(it : any) {
				uni.navigateTo({
					url: '/pages/detail/detail?propid=' + it.propid + '&name=' +
						encodeURIComponent(it.name)
				})
			},
			actionText(a : string) : string {
				if (a == 'BUY') return '买入'
				if (a == 'SELL') return '卖出'
				return '观望'
			},
			fmtPrice(v : any) : string { return fmtPrice(v) }
		}
	}
</script>

<style>
	.page {
		background-color: #f5f6f8;
		min-height: 100vh;
	}

	.tip {
		background-color: #fffaf0;
		padding: 10px 14px;
		border-bottom-width: 1px;
		border-bottom-color: #feebc8;
		border-bottom-style: solid;
	}

	.tip-text {
		font-size: 12px;
		color: #975a16;
		line-height: 17px;
	}

	.list { padding: 10px; }

	.card {
		background-color: #ffffff;
		border-radius: 8px;
		padding: 14px;
		margin-bottom: 10px;
	}

	.card-head {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.name {
		font-size: 15px;
		font-weight: bold;
		color: #1f2329;
	}

	.score {
		font-size: 12px;
		color: #c05621;
		background-color: #fffaf0;
		padding: 2px 8px;
		border-radius: 10px;
	}

	.card-body {
		display: flex;
		flex-direction: row;
		margin-top: 12px;
	}

	.col {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.label {
		font-size: 11px;
		color: #8a9099;
	}

	.value {
		font-size: 15px;
		color: #1f2329;
		font-weight: bold;
		margin-top: 3px;
	}

	.value.gain { color: #c53030; }
	.value.buy { color: #c53030; }
	.value.sell { color: #276749; }

	.reason {
		font-size: 11px;
		color: #8a9099;
		margin-top: 10px;
		line-height: 16px;
	}

	.empty {
		padding: 70px 0;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.empty text { color: #8a9099; font-size: 14px; }
	.empty-sub { font-size: 12px; margin-top: 6px; }
</style>
